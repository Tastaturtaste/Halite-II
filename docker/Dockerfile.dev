# Build docker image on linux (or wsl), otherwise symlinks will not work correctly.
# The resulting image can be used on windows.
#
# Toolchain image for the historical Halite II stack (Python 3.6, Node 8,
# Ruby 2.5) so the repo can be built and run in isolation. The repository is
# bind-mounted into /workspace; dependencies are installed on first open by
# scripts/dev_setup.sh (see .devcontainer/devcontainer.json).

FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        curl \
        ca-certificates \
        pkg-config \
        libssl-dev \
        libffi-dev \
        zlib1g-dev \
        libbz2-dev \
        libreadline-dev \
        libsqlite3-dev \
        libncurses5-dev \
        libgdbm-dev \
        libyaml-dev \
        libxml2-dev \
        libxslt1-dev \
        libjpeg-dev \
        libpng-dev \
        mariadb-client \
        tmux \
        procps \
        unzip \
        zip \
        sudo \
        vim \
    && rm -rf /var/lib/apt/lists/*

# Non-root runtime user "halite", matching the host uid/gid (1000), with
# passwordless sudo. Toolchain installs below run as root (they write to
# /usr/local); the final USER switches the container to halite.
ARG USER_ID=1000
ARG GROUP_ID=1000
RUN groupadd -g ${GROUP_ID} halite \
    && useradd -m -u ${USER_ID} -g halite -s /bin/bash halite \
    && usermod -aG sudo halite \
    && echo 'halite ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/halite \
    && chmod 0440 /etc/sudoers.d/halite

# Node 8.17.0 (required by webpack 3 and node-sass 4.5.3) via nvm
ENV NVM_DIR=/usr/local/nvm
RUN mkdir -p "$NVM_DIR" \
    && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash \
    && . "$NVM_DIR/nvm.sh" \
    && nvm install 8.17.0 \
    && nvm alias default 8.17.0
ENV PATH="$NVM_DIR/versions/node/v8.17.0/bin:$PATH"

# Python 3.6.15 (Flask 0.12 / SQLAlchemy 1.1 pins) via pyenv
RUN git clone --depth=1 https://github.com/pyenv/pyenv.git /usr/local/pyenv
ENV PYENV_ROOT=/usr/local/pyenv
ENV PATH="$PYENV_ROOT/bin:$PATH"
RUN pyenv install 3.6.15 && pyenv global 3.6.15
ENV PATH="$PYENV_ROOT/versions/3.6.15/bin:$PATH"

# Ruby 2.5.9 + Bundler 1.16.0.pre.3 (Jekyll 3.4.4) via rbenv
RUN git clone --depth=1 https://github.com/rbenv/rbenv.git /usr/local/rbenv \
    && git clone --depth=1 https://github.com/rbenv/ruby-build.git /usr/local/rbenv/plugins/ruby-build
ENV RBENV_ROOT=/usr/local/rbenv
ENV PATH="$RBENV_ROOT/bin:$PATH"
RUN rbenv install 2.5.9 && rbenv global 2.5.9
ENV PATH="$RBENV_ROOT/versions/2.5.9/bin:$PATH"
RUN gem install bundler -v 1.16.0.pre.3

WORKDIR /workspace
USER halite
CMD ["/bin/bash", "-c", "sleep infinity"]