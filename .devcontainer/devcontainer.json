{
  "name": "Halite II Dev",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "halite",
  "shutdownAction": "stopCompose",
  "forwardPorts": [4000, 5000, 5001],
  "postCreateCommand": "bash /workspace/scripts/dev_setup.sh",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "editorconfig.editorconfig"]
    }
  }
}